                    <mxGeometry x="1230" y="130" width="270" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="28" value="TBD" style="whiteSpace=wrap;" parent="25" vertex="1">
                    <mxGeometry x="130" y="190" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="69" style="edgeStyle=none;html=1;endArrow=none;endFill=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="31" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1300" y="350" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="31" value="No clue what to do here yet, this is a later problem (have to wait for control systems). &#xa;&#xa;Will have to figure out how to actually &#xa;send the livestream with overlayed telemetry to some destination later" style="shape=note;size=15;align=left;spacingLeft=10;whiteSpace=wrap;fontSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1210" y="490" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="39" style="edgeStyle=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="52" target="2" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="-180" y="350" as="sourcePoint"/>
                        <mxPoint x="-110" y="349.5" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="47" style="edgeStyle=none;html=1;endArrow=none;endFill=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="46" target="12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="46" value="When dashboard is entered, websocket opened from frontend side telling it to launch a FFmpeg subprocess to monitor a video source, convert it to a streamable format (i.e Fmp4), then pipe it to the webserver who reads and sends it asyncronously to the frontend." style="shape=note;size=15;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontSize=8;" parent="1" vertex="1">
                    <mxGeometry x="750" y="490" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="49" style="edgeStyle=none;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=none;endFill=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="48" target="8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="48" value="Proof of concept uses FFmpeg for now, there is approximately a 2-3 second delay to stream (FFmpeg essentially probes ahead and keeps some data buffered for processing), might thus use something else." style="shape=note;size=15;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontSize=8;" parent="1" vertex="1">
                    <mxGeometry x="520" y="490" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="51" style="edgeStyle=none;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=none;endFill=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="50" target="3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="50" value="Or just anything tbh that converts the raw 3.5mm CVBS NTSC/PAL signal into something actually readable" style="shape=note;size=15;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontSize=8;" parent="1" vertex="1">
                    <mxGeometry x="220" y="490" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="53" value="Rocket (Control Systems)" style="swimlane;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-270" y="280" width="230" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="52" value="VTX" style="whiteSpace=wrap;html=1;" parent="53" vertex="1">
                    <mxGeometry x="55" y="40" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="57" style="edgeStyle=none;html=1;endArrow=none;endFill=0;" parent="1" source="56" target="19" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="56" value="If frontend has lagspikes (e.x if a bunch of things get rendered at once), there can be issues with the MSE breaking due to it not appending data to buffer fast enough before new data is sent from websocket). I have dealt with this by adding a queue based pre-buffer in the frontend. The MSE can thus catch up after a lag spike.&amp;nbsp;" style="shape=note;size=15;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="590" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="58" value="Otherwise, we should be able to handle high quality livestreams easily (Based off of testing with a 4K MP4 and my laptop webcam)" style="shape=note;size=15;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="690" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="59" style="edgeStyle=none;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=none;endFill=0;" parent="1" source="58" target="56" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="65" style="edgeStyle=none;html=1;endArrow=none;endFill=0;" parent="1" source="64" target="46" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="64" value="Based off of testing, there are no issues with doing this and reading data from avionics telemetry at the same time" style="shape=note;size=15;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontSize=8;" parent="1" vertex="1">
                    <mxGeometry x="750" y="590" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="67" style="edgeStyle=none;html=1;endArrow=none;endFill=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="66" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="650" y="290" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="66" value="If somehow the FFmpeg process prematurely terminates because capture card disconnects partway through or smth, I can do smth similar to the avionics radio reciever whereby we can periodically check if capture card is connected again as a device before relaunching FFmpeg to resume the stream." style="shape=note;size=15;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontSize=8;" parent="1" vertex="1">
                    <mxGeometry x="520" y="20" width="180" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="68" style="edgeStyle=none;html=1;" parent="1" source="13" target="28" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
