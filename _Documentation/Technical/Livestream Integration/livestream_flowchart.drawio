                <mxCell id="19" value="Built in MSE (Embedded in webview itself) can automatically decode and append to a video buffer that can be autoplayed (can thus just send the raw data from the buffer into frontend (without worrying about which frame the data is in) (P.S this was a pain in the ass to deal with cause theres not much docs on this)" style="shape=note;size=15;align=left;spacingLeft=10;html=1;whiteSpace=wrap;fontSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="490" width="180" height="90" as="geometry"/>
                </mxCell>
